{
    "id" : "io.github.kelvinnovais.Kasasa",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "kasasa",
    "finish-args" : [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=xdg-pictures"
    ],
    "cleanup" : [
        "/include",
        "/lib/girepository-1.0",
        "/lib/pkgconfig",
        "/share/gir-1.0"
    ],
    "modules" : [
        {
            "name" : "libportal",
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dbackend-gtk3=disabled",
                "-Dbackend-gtk4=enabled",
                "-Dbackend-qt5=disabled",
                "-Dbackend-qt6=disabled",
                "-Dportal-tests=false",
                "-Dintrospection=true",
                "-Ddocs=false",
                "-Dtests=false",
                "-Dvapi=false"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/flatpak/libportal.git",
                    "tag" : "0.9.1",
                    "commit" : "8f5dc8d192f6e31dafe69e35219e3b707bde71ce"
                }
            ]
        },
        {
            "name" : "kasasa",
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type": "git",
                    "url": "https://github.com/KelvinNovais/Kasasa",
                    "tag": "v1.1.6",
                    "commit": "d0caf098e61d5dc518ebcb89a6296502b5ac7d60"
                }
            ]
        }
    ]
}
